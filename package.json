{
  "name": "react-example",
  "description": "PARSER by FRESKO CT",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "author": "FRESKO CT",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "electron .",
    "build:vite": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --external:playwright --external:express --external:vite --external:cheerio --external:uuid --outfile=dist-server/server.js",
    "build": "npm run build:vite && npm run build:server",
    "dist": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron",
    "lint": "tsc --noEmit"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.fresko.parser",
    "productName": "PARSER Fresko CT",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
